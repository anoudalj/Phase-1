import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.io.File;

public class GymGUI extends JFrame implements ActionListener {

    Gym gym;

    JButton customerButton;
    JButton membershipsButton;
    JButton exitButton;

    JLabel titleLabel;
    JLabel imageLabel;

    public GymGUI() {

        gym = new Gym("Power Gym", 1000);

        File f = new File("Memberships.dat");
        File f2 = new File("Subscriptions.dat");

        if (f.exists() && f2.exists()) {

            gym.readAllData();
        }

        else {

            gym.addMembership(
                    new RegularMembership(3,101,
                            "Regular",250));

            gym.addMembership(
                    new RegularMembership(6,102,
                            "Regular",300));

            gym.addMembership(
                    new PremiumMembership(true,false,
                            201,"Premium",500));

            gym.addMembership(
                    new VIPMembership(2,true,
                            true,301,"VIP",800));
        }

        setTitle("Gym Subscription System");

        setSize(700,500);

        setLayout(null);

        getContentPane().setBackground(Color.white);

        titleLabel =
                new JLabel("Welcome To Our Gym System");

        titleLabel.setBounds(170,40,400,50);

        titleLabel.setFont(
                new Font("Arial",Font.BOLD,30));

        add(titleLabel);

        customerButton =
                new JButton("Add Subscription");

        customerButton.setBounds(80,150,180,40);

        membershipsButton =
                new JButton("View Memberships");

        membershipsButton.setBounds(80,220,180,40);

        exitButton =
                new JButton("Exit");

        exitButton.setBounds(80,290,180,40);

        add(customerButton);
        add(membershipsButton);
        add(exitButton);

        customerButton.addActionListener(this);

        membershipsButton.addActionListener(this);

        exitButton.addActionListener(this);
imageLabel = new JLabel("🏋️");

imageLabel.setBounds(420,170,200,200);

imageLabel.setFont(
        new Font("Arial", Font.PLAIN, 120));

add(imageLabel);

        setVisible(true);

        setDefaultCloseOperation(
                JFrame.EXIT_ON_CLOSE);
    }

    public void actionPerformed(ActionEvent e) {

        if (e.getSource() == customerButton) {

            String membershipId =
                    JOptionPane.showInputDialog(
                            "Enter Membership ID");

            Membership membership =
                    gym.searchMembership(
                            Integer.parseInt(
                                    membershipId));

            if (membership == null ||
                    !membership.isAvailable()) {

                JOptionPane.showMessageDialog(
                        this,
                        "Membership not available");

                return;
            }

            String name =
                    JOptionPane.showInputDialog(
                            "Enter Full Name");

            String phone =
                    JOptionPane.showInputDialog(
                            "Enter Phone Number");

            String customerId =
                    JOptionPane.showInputDialog(
                            "Enter Customer ID");

            String months =
                    JOptionPane.showInputDialog(
                            "Enter Number Of Months");

            Subscription sub =
                    new Subscription(
                            name,
                            phone,
                            customerId);

            sub.subscribe(
                    membership,
                    Integer.parseInt(months));

            gym.addSubscription(sub);

            gym.saveAllInfo();

            JOptionPane.showMessageDialog(
                    this,
                    "Subscription Added Successfully");
        }

        if (e.getSource() == membershipsButton) {

            JFrame frame =
                    new JFrame("Memberships");

            JTextArea area =
                    new JTextArea();

            List list =
                    gym.getAllMemberships();

            Node current =
                    list.getHead();

            while(current != null) {

                area.append(
                        current.getData()
                                .toString()
                                + "\n\n");

                current =
                        current.getNext();
            }

            area.setEditable(false);

            frame.add(
                    new JScrollPane(area));

            frame.setSize(500,400);

            frame.setVisible(true);
        }

        if (e.getSource() == exitButton) {

            System.exit(0);
        }
    }

    public static void main(String[] args) {

        new GymGUI();
    }
}
