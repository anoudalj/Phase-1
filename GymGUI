import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.io.File;

public class GymGUI extends JFrame implements ActionListener {

    Gym gym;

    JButton customerButton;
    JButton membershipsButton;
    JButton exitButton;

    JLabel titleLabel;
    JLabel imageLabel;

    public GymGUI() {

        gym = new Gym("Power Gym", 1000);

        File f = new File("Memberships.dat");
        File f2 = new File("Subscriptions.dat");

        if (f.exists() && f2.exists()) {

            gym.readAllData();
        }

        else {

            gym.addMembership(
                    new RegularMembership(3,101,
                            "Regular",250));

            gym.addMembership(
                    new RegularMembership(6,102,
                            "Regular",300));

            gym.addMembership(
                    new PremiumMembership(true,false,
                            201,"Premium",500));

            gym.addMembership(
                    new VIPMembership(2,true,
                            true,301,"VIP",800));
        }

        setTitle("Gym Subscription System");

        setSize(1250,700);
        
        setLayout(null);

        getContentPane().setBackground(Color.white);

        titleLabel =new JLabel("Welcome To Our Gym System");
         
        titleLabel.setBounds(280,50,1200,100);
                
        titleLabel.setFont(new Font("Arial",Font.BOLD,30));
        
        add(titleLabel);

        customerButton = new JButton("Add Subscription");

        customerButton.setBounds(160,190,220,45);
        
        membershipsButton = new JButton("View Memberships");

        membershipsButton.setBounds(160,270,220,45);

        exitButton = new JButton("Exit");

        exitButton.setBounds(160,350,220,45);

        add(customerButton);
        add(membershipsButton);
        add(exitButton);

        customerButton.addActionListener(this);

        membershipsButton.addActionListener(this);

        exitButton.addActionListener(this);

         ImageIcon icon = new ImageIcon("gym-ladies-banner.png");

         Image img = icon.getImage();

         Image scaledImg =img.getScaledInstance(400,300,Image.SCALE_SMOOTH);
         
         ImageIcon gymImage = new ImageIcon(scaledImg);
         
         imageLabel = new JLabel(gymImage);

         imageLabel.setBounds(470,170,400,300);         

         add(imageLabel);

        setVisible(true);

        setDefaultCloseOperation(
                JFrame.EXIT_ON_CLOSE);
    }

    public void actionPerformed(ActionEvent e) {

        if (e.getSource() == customerButton) {

            String membershipId =
                    JOptionPane.showInputDialog(
                            "Enter Membership ID");

            Membership membership =
                    gym.searchMembership(
                            Integer.parseInt(
                                    membershipId));

            if (membership == null ||
                    !membership.isAvailable()) {

                JOptionPane.showMessageDialog(
                        this,
                        "Membership not available");

                return;
            }

            String name =
                    JOptionPane.showInputDialog(
                            "Enter Full Name");

            String phone =
                    JOptionPane.showInputDialog(
                            "Enter Phone Number");

            String customerId =
                    JOptionPane.showInputDialog(
                            "Enter Customer ID");

            String months =
                    JOptionPane.showInputDialog(
                            "Enter Number Of Months");

            Subscription sub =
                    new Subscription(
                            name,
                            phone,
                            customerId);

            sub.subscribe(
                    membership,
                    Integer.parseInt(months));

            gym.addSubscription(sub);

            gym.saveAllInfo();

           JTextArea area = new JTextArea(sub.toString());

area.setEditable(false);

JOptionPane.showMessageDialog(
        this,
        new JScrollPane(area),
        "Subscription Details",
        JOptionPane.INFORMATION_MESSAGE);
                }

        if (e.getSource() == membershipsButton) {

            JFrame frame =
                    new JFrame("Memberships");

            JTextArea area =
                    new JTextArea();

            List list =
                    gym.getAllMemberships();

            Node current =
                    list.getHead();

            while(current != null) {

                area.append(
                        current.getData()
                                .toString()
                                + "\n\n");

                current =
                        current.getNext();
            }

            area.setEditable(false);

            frame.add(
                    new JScrollPane(area));

            frame.setSize(500,400);

            frame.setVisible(true);
        }

        if (e.getSource() == exitButton) {

            System.exit(0);
        }
    }

    public static void main(String[] args) {

        new GymGUI();
    }
}
